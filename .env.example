# The brand enquiry form on /brands POSTs here, tagged source: "creator-brands".
# The consulting form on /services/consulting uses the same webhook with a
# different source tag, so the two can be routed apart downstream.
#
# With this unset, the forms show an honest error and point the visitor at the
# Cal.com booking button instead. They never fake a success.
NEXT_PUBLIC_N8N_CONSULTING_FORM_WEBHOOK=
